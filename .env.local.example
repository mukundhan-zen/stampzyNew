# Stamp Collection Tracker Environment Variables
# Copy this file to .env.local and replace the placeholder values

# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (for server-side operations)
# Only add this if you need server-side admin operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Configuration
# Environment: development, production, or staging
NODE_ENV=development

# Optional: Application-specific configurations
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_NAME="Stamp Collection Tracker"

# Optional: Third-party integrations
# Add any additional API keys or service configurations as needed
# CURRENCY_API_KEY=your-currency-api-key
# CATALOG_API_KEY=your-catalog-api-key
